---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { nav, site } from '../data/site';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer frost">
  <div class="container grid-footer">
    <div class="about">
      <a class="brand" href={withBase('/')}>
        <Image src={logo} alt="" width={56} height={56} layout="fixed" />
        <span>
          <strong>{site.name}</strong>
          <span class="muted-light">FRC Team {site.teamNumber} · {site.location}</span>
        </span>
      </a>
      <p>
        Students from {site.school} designing, building and programming competition robots since {site.rookieYear}.
      </p>
      <div class="social">
        <a href={site.social.facebook} rel="noopener" target="_blank">
          <Icon name="facebook" label="SubZero Robotics on Facebook" />
        </a>
        <a href={site.social.instagram} rel="noopener" target="_blank">
          <Icon name="instagram" label="SubZero Robotics on Instagram" />
        </a>
        <a href={site.social.tiktok} rel="noopener" target="_blank">
          <Icon name="tiktok" label="SubZero Robotics on TikTok" />
        </a>
        <a href={site.social.github} rel="noopener" target="_blank">
          <Icon name="github" label="SubZero Robotics on GitHub" />
        </a>
        <a href={`mailto:${site.email}`}>
          <Icon name="mail" label="Email SubZero Robotics" />
        </a>
        <a href={withBase('/rss.xml')}>
          <Icon name="rss" label="News RSS feed" />
        </a>
      </div>
    </div>

    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        <li><a href={withBase('/')}>Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)}>{item.label}</a>
            </li>
          ))
        }
        <li><a href={withBase('/contact/')}>Contact</a></li>
      </ul>
    </nav>

    <div>
      <h2>Get in touch</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          <address>
            {site.address.lines.slice(1).map((line) => <span>{line}</span>)}
          </address>
        </li>
      </ul>
    </div>

    <div>
      <h2>Team stats</h2>
      <ul>
        <li><a href={site.social.blueAlliance} rel="noopener" target="_blank">The Blue Alliance <Icon name="external" size={14} /></a></li>
        <li><a href={site.social.firstEvents} rel="noopener" target="_blank">FIRST Events <Icon name="external" size={14} /></a></li>
        <li><a href="https://www.firstinspires.org/" rel="noopener" target="_blank">About FIRST <Icon name="external" size={14} /></a></li>
      </ul>
    </div>
  </div>

  <div class="container legal">
    <p>© {year} {site.name}, Team {site.teamNumber}.</p>
    <p>FIRST® and FIRST® Robotics Competition are registered trademarks of FIRST.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(48px, 7vw, 80px);
    font-size: 0.95rem;
  }
  .grid-footer {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  .about {
    grid-column: span 2;
    max-width: 420px;
  }
  @media (max-width: 640px) {
    .grid-footer {
      grid-template-columns: 1fr 1fr;
      gap: 28px 20px;
    }
    .about {
      grid-column: 1 / -1;
    }
    nav ul {
      grid-template-columns: 1fr 1fr;
      gap: 6px 12px;
    }
    nav {
      grid-column: 1 / -1;
    }
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff !important;
    text-decoration: none;
    margin-bottom: 16px;
  }
  .brand strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .muted-light,
  p {
    color: rgb(214 228 247 / 0.78);
  }
  .muted-light {
    font-size: 0.85rem;
  }
  h2 {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ice-300);
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  a:not(.brand) {
    color: rgb(230 240 255 / 0.88) !important;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  a:not(.brand):hover {
    color: #fff !important;
    text-decoration: underline;
  }
  address {
    font-style: normal;
    display: grid;
    color: rgb(214 228 247 / 0.78);
  }
  .social {
    display: flex;
    gap: 8px;
  }
  .social a {
    width: 42px;
    height: 42px;
    justify-content: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
  }
  .social a:hover {
    background: rgb(255 255 255 / 0.16);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    margin-top: 48px;
    padding-block: 20px 28px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.82rem;
  }
  .legal p {
    margin: 0;
  }
</style>
