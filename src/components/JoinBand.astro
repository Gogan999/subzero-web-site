---
// Photo band inviting students to join, with the departments written out as a sentence.
import { Image } from 'astro:assets';
import { subteams } from '../data/subteams';
import { withBase } from '../lib/url';
import photo from '../assets/gallery/2026-season-highlights/05.jpg';

const names = subteams.map((t) => t.name.replace(/ & /g, ' and ').toLowerCase().replace('cad', 'CAD'));
const departments = `${names.slice(0, -1).join(', ')} and ${names.at(-1)}`;
---

<section class="join">
  <Image src={photo} alt="" class="bg" widths={[640, 960, 1280, 1600]} sizes="100vw" />
  <div class="container">
    <h2>Join the team</h2>
    <p class="text">
      {`Any Esko High School student can join, and no experience is needed. Students work in one of ${subteams.length} departments: ${departments}.`}
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href={withBase('/contact/#join')}>How to join</a>
      <a class="textlink" href={withBase('/sponsors/')}>Support the team</a>
    </div>
  </div>
</section>

<style>
  .join {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(64px, 10vw, 120px);
    border-top: 1px solid var(--border);
  }
  .join :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .join::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(8 17 31 / 0.95) 35%, rgb(8 17 31 / 0.55) 100%);
  }
  .text {
    max-width: 54ch;
    margin-bottom: 24px;
    color: var(--text-soft);
  }
</style>
