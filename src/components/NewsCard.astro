---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate } from '../lib/content';
import { withBase } from '../lib/url';

interface Props {
  post: CollectionEntry<'news'>;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel: Heading = 'h3' } = Astro.props;
const { title, date, summary, cover, coverAlt, tags } = post.data;
---

<article class="news-card">
  {
    cover && (
      <div class="media">
        <Image src={cover} alt={coverAlt ?? ''} width={640} height={400} fit="cover" widths={[400, 640, 800]} sizes="(min-width: 1200px) 380px, (min-width: 700px) 45vw, 100vw" />
      </div>
    )
  }
  <div class="body">
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {tags[0] && <span class="tag">· {tags[0]}</span>}
    </p>
    <Heading class="title">
      <a href={withBase(`/news/${post.id}/`)}>{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    position: relative;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }
  .news-card:has(.media) {
    border-top: 0;
    padding-top: 0;
  }
  .news-card:hover .title a {
    text-decoration: underline;
  }
  .media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-2);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 14px 0 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    margin-bottom: 6px;
  }
  .title {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  /* whole card clickable */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .news-card:has(.title a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .summary {
    color: var(--text-soft);
    font-size: 0.98rem;
    margin: 0;
  }
  @media (max-width: 640px) {
    .news-card {
      flex-direction: row;
      gap: 14px;
    }
    .media {
      flex: none;
      width: 108px;
      aspect-ratio: auto;
    }
    .body {
      padding: 0;
    }
    .meta {
      margin-bottom: 4px;
      font-size: 0.78rem;
    }
    .meta .tag {
      display: none;
    }
    .title {
      font-size: 1.02rem;
      margin-bottom: 4px;
    }
    .summary {
      font-size: 0.88rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
