---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate } from '../lib/content';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  post: CollectionEntry<'news'>;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel: Heading = 'h3' } = Astro.props;
const { title, date, summary, cover, coverAlt, tags } = post.data;
---

<article class="news-card card">
  <div class="media">
    {
      cover ? (
        <Image src={cover} alt={coverAlt ?? ''} width={640} height={400} fit="cover" widths={[400, 640, 800]} sizes="(min-width: 1200px) 380px, (min-width: 700px) 45vw, 100vw" />
      ) : (
        <div class="placeholder frost" aria-hidden="true">
          <Icon name="snowflake" size={56} />
        </div>
      )
    }
  </div>
  <div class="body">
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {tags[0] && <span class="pill">{tags[0]}</span>}
    </p>
    <Heading class="title">
      <a href={withBase(`/news/${post.id}/`)}>{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .news-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-2);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    color: rgb(143 211 255 / 0.6);
  }
  .body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 10px;
  }
  .title {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  /* whole card clickable */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .news-card:has(.title a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .summary {
    color: var(--text-muted);
    font-size: 0.98rem;
    margin: 0;
  }
</style>
