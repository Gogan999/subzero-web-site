---
// Dark banner at the top of interior pages, with an optional faded photo behind the title.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  image?: ImageMetadata;
  /** CSS object-position for the background photo. */
  imagePosition?: string;
}
const { title, eyebrow, lead, image, imagePosition = 'center' } = Astro.props;
---

<section class="page-header frost">
  {
    image && (
      <Image
        src={image}
        alt=""
        class="bg"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        loading="eager"
        style={`object-position:${imagePosition}`}
      />
    )
  }
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(48px, 7vw, 72px) clamp(40px, 6vw, 60px);
    border-bottom: 1px solid var(--border);
  }
  .page-header :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    z-index: -2;
  }
  .page-header::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, var(--bg) 20%, rgb(5 11 22 / 0.55) 100%);
  }
  h1 {
    max-width: 16ch;
    margin-bottom: 0.3em;
  }
  .lead {
    max-width: 52ch;
    margin-bottom: 0;
  }
</style>
