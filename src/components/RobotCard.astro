---
import { Image } from 'astro:assets';
import type { Robot } from '../lib/content';

interface Props {
  robot: Robot;
  /** The current robot: spans two columns with the photo beside the text. */
  featured?: boolean;
}
const { robot, featured = false } = Astro.props;
const title = robot.name ?? `${robot.year} robot`;
---

<article class:list={['robot-card', { featured }]} id={`robot-${robot.year}`}>
  <div class="media">
    {
      robot.image ? (
        <Image src={robot.image} alt={`${title}, SubZero's ${robot.year} robot`} width={featured ? 900 : 640} height={featured ? 620 : 440} fit="cover" widths={featured ? [480, 720, 900] : [400, 640, 900]} sizes={featured ? '(min-width: 1100px) 460px, (min-width: 700px) 50vw, 100vw' : '(min-width: 1100px) 360px, (min-width: 700px) 45vw, 100vw'} />
      ) : (
        <div class="placeholder" aria-hidden="true">Photo coming soon</div>
      )
    }
  </div>
  <div class="body">
    <p class="meta">{robot.year} · {robot.game}{featured && ' · current robot'}</p>
    <h3>{title}</h3>
    {robot.summary && <p class="summary">{robot.summary}</p>}
    {robot.specs.length > 0 && <p class="specs">{robot.specs.join(' · ')}</p>}
    {
      robot.awards.length > 0 && (
        <ul class="award-list">
          {robot.awards.map((a) => (
            <li>
              {a.name.replace(/ sponsored by .*/, '')}, {a.event}
            </li>
          ))}
        </ul>
      )
    }
    {
      (robot.binder || robot.onshape || robot.video) && (
        <p class="links">
          {robot.binder && (
            <a href={robot.binder} rel="noopener" target="_blank">
              Technical binder
            </a>
          )}
          {robot.onshape && (
            <a href={robot.onshape} rel="noopener" target="_blank">
              CAD model
            </a>
          )}
          {robot.video && (
            <a href={robot.video} rel="noopener" target="_blank">
              Watch
            </a>
          )}
        </p>
      )
    }
  </div>
</article>

<style>
  .robot-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .featured {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 0 28px;
    align-items: start;
  }
  .media {
    aspect-ratio: 16 / 11;
    background: var(--surface);
    margin-bottom: 14px;
  }
  .featured .media {
    margin: 0;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .body > * {
    margin: 0;
  }
  h3 {
    font-size: 1.6rem;
    font-stretch: 78%;
    font-weight: 750;
  }
  .featured h3 {
    font-size: 2.4rem;
  }
  .summary {
    color: var(--text-soft);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .specs {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .award-list {
    font-size: 0.93rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  @media (max-width: 1000px) {
    .featured {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 700px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .featured .media {
      margin-bottom: 14px;
    }
  }
  @media (max-width: 640px) {
    .featured {
      grid-column: auto;
    }
  }
</style>
