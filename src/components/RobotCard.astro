---
import { Image } from 'astro:assets';
import type { Robot } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  robot: Robot;
  featured?: boolean;
}
const { robot, featured = false } = Astro.props;
const title = robot.name ?? `${robot.year} Robot`;
---

<article class:list={['robot-card', { featured }]} id={`robot-${robot.year}`}>
  <div class="media">
    {
      robot.image ? (
        <Image src={robot.image} alt={`${title}, SubZero's ${robot.year} robot`} width={640} height={440} fit="cover" widths={[400, 640, 900]} sizes="(min-width: 1100px) 360px, (min-width: 700px) 45vw, 100vw" />
      ) : (
        <div class="placeholder frost" aria-hidden="true">
          <Icon name="bot" size={56} />
          <span>Photo coming soon</span>
        </div>
      )
    }
    <span class="year">{robot.year}</span>
  </div>
  <div class="body">
    <p class="game">{robot.game}</p>
    <h3>{title}</h3>
    {robot.summary && <p class="summary">{robot.summary}</p>}
    {
      robot.specs.length > 0 && (
        <ul class="specs" role="list">
          {robot.specs.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      )
    }
    {
      robot.awards.length > 0 && (
        <ul class="awards" role="list">
          {robot.awards.map((a) => (
            <li class="pill pill--gold" title={a.event}>
              <Icon name="trophy" size={12} /> {a.name.replace(/ sponsored by .*/, '')}
            </li>
          ))}
        </ul>
      )
    }
    {
      (robot.binder || robot.onshape || robot.video) && (
        <div class="links">
          {robot.binder && (
            <a class="btn btn--primary btn--sm" href={robot.binder} rel="noopener" target="_blank">
              <Icon name="pen" size={16} /> Technical binder
            </a>
          )}
          {robot.onshape && (
            <a class="btn btn--ghost btn--sm" href={robot.onshape} rel="noopener" target="_blank">
              <Icon name="box" size={16} /> CAD model
            </a>
          )}
          {robot.video && (
            <a class="btn btn--ghost btn--sm" href={robot.video} rel="noopener" target="_blank">
              Watch
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .robot-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease;
  }
  .robot-card:hover {
    border-color: rgb(143 211 255 / 0.5);
  }
  .featured {
    border-color: var(--gold-400);
  }
  .media {
    position: relative;
    aspect-ratio: 16 / 11;
    background: var(--navy-900);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    color: rgb(143 211 255 / 0.65);
    font-family: var(--font-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .year {
    position: absolute;
    top: 0;
    left: 0;
    padding: 6px 12px;
    background: rgb(5 11 22 / 0.88);
    color: #fff;
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 900;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }
  .featured .year {
    background: var(--gold-400);
    color: var(--on-accent);
  }
  .body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .body > * {
    margin: 0;
  }
  .game {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ice-300);
  }
  h3 {
    font-size: 2rem;
  }
  .summary {
    color: var(--text-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .specs {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .specs li {
    display: flex;
    gap: 10px;
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .specs li::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-top: 7px;
    flex: none;
    background: var(--ice-300);
    transform: rotate(45deg);
  }
  .awards {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .awards .pill {
    font-size: 0.75rem;
  }
  .links {
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
