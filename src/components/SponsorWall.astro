---
import { getSponsorGroups, getSponsors } from '../lib/sponsors';
import SponsorLogo from './SponsorLogo.astro';

interface Props {
  /** "full" = larger sponsors first, sized by tier (tier names stay private); "strip" = one compact row of logos. */
  variant?: 'full' | 'strip';
}
const { variant = 'full' } = Astro.props;
const groups = variant === 'full' ? await getSponsorGroups() : [];
const strip = variant === 'strip' ? (await getSponsors('current')).sort((a, b) => order(a.size) - order(b.size)) : [];
function order(size: string) {
  return ['xl', 'lg', 'md', 'sm', 'xs'].indexOf(size);
}
---

{
  variant === 'full' ? (
    <div class="wall">
      {groups.map((g) => (
        <ul class={`wall-row row-${g.sponsors[0].size}`} role="list">
            {g.sponsors.map((s) => (
              <li>
                <SponsorLogo sponsor={s} />
              </li>
            ))}
        </ul>
      ))}
    </div>
  ) : (
    <ul class="strip" role="list">
      {strip.map((s) => (
        <li class={`strip-${s.size}`}>
          <SponsorLogo sponsor={{ ...s, size: s.size === 'xl' || s.size === 'lg' ? 'md' : 'sm' }} />
        </li>
      ))}
    </ul>
  )
}

<style>
  /* One centered row per giving level, largest first; tile width is the only cue. */
  .wall {
    display: grid;
    gap: 14px;
  }
  .wall-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .wall-row li {
    flex: 0 1 var(--w);
  }
  .row-xl {
    --w: 360px;
  }
  .row-lg {
    --w: 300px;
  }
  .row-md {
    --w: 228px;
  }
  .row-sm {
    --w: 176px;
  }
  .row-xs {
    --w: 136px;
  }
  @media (max-width: 640px) {
    .row-xl,
    .row-lg {
      --w: 100%;
    }
    .row-md {
      --w: calc(50% - 7px);
    }
    .row-sm,
    .row-xs {
      --w: calc(33.333% - 10px);
    }
  }
  .wall-row li,
  .strip li {
    display: grid;
  }
  .strip {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .strip-xl,
  .strip-lg,
  .strip-md {
    flex: 0 1 200px;
  }
  .strip-sm,
  .strip-xs {
    flex: 0 1 160px;
  }
  @media (max-width: 640px) {
    .strip li {
      flex: 0 1 calc(50% - 5px);
    }
  }
</style>
