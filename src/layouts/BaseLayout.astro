---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const { title, description = site.description, image, type = 'website', publishedTime, noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ${site.name} ${site.teamNumber}` : `${site.name} · FRC Team ${site.teamNumber}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImagePath = image
  ? (await getImage({ src: image, width: 1200, format: 'jpg' })).src
  : withBase('/og-default.jpg');
const ogImage = new URL(ogImagePath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0a1730" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} News`} href={withBase('/rss.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.name} · Team ${site.teamNumber}`} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
