---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { coreValues, subteams } from '../data/subteams';
import { withBase } from '../lib/url';

import teamPhoto from '../assets/news/iowa-regional-champions.jpg';

const people = await getCollection('people');
const groups = [
  { key: 'coach', title: 'Coaches' },
  { key: 'mentor', title: 'Mentors' },
  { key: 'consultant', title: 'Consultants' },
] as const;

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2);
---

<BaseLayout
  title="About"
  description="Meet SubZero Robotics, Esko High School's FIRST Robotics Competition team: what FIRST is, our core values, our departments, and the coaches and mentors who guide us."
>
  <PageHeader
    eyebrow="About SubZero"
    title="Students, mentors and a whole lot of aluminum."
    lead={`SubZero Robotics was founded in ${site.founded} at Esko High School and competed in our first FIRST Robotics Competition season in ${site.rookieYear}.`}
  />

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Our story</p>
        <h2>From rookies to regional champions</h2>
        <p>
          In our rookie year we built T.O.M. from the Kit of Parts and won the Rookie Inspiration Award at the Lake
          Superior Regional. A year later, Sir B.A.R.D. earned an Industrial Design Award and took us to the FIRST
          Championship in St. Louis. Since then we've won the 2017 Iowa Regional and the 2019 Lake Superior Regional,
          competed at three FIRST Championships, and earned awards for engineering, controls, creativity, spirit and
          gracious professionalism.
        </p>
        <div class="inline-links">
          <a class="link-arrow" href={withBase('/history/')}>Season history <Icon name="arrow-right" size={16} /></a>
          <a class="link-arrow" href={withBase('/robots/')}>Our robots <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
      <Image src={teamPhoto} alt="SubZero Robotics with the 2017 Iowa Regional winner banner" width={640} widths={[480, 640, 960]} sizes="(min-width: 960px) 480px, 100vw" class="rounded" />
    </div>
  </section>

  <section class="section section--alt" id="first">
    <div class="container two-col">
      <div class="card panel">
        <p class="eyebrow">What is FIRST?</p>
        <h2>The varsity sport for the mind</h2>
        <p>
          <a href="https://www.firstinspires.org/" rel="noopener">FIRST</a> (For Inspiration and Recognition of Science
          and Technology) is a global nonprofit that inspires young people to become leaders and innovators in STEM.
        </p>
        <p>
          In the <strong>FIRST Robotics Competition</strong>, high school teams get a new game every January and just a
          few weeks to design, build, wire and program an industrial-sized robot to play it. Teams also raise their own
          funds, build their brand, run outreach and practice <em>Gracious Professionalism®</em>: competing hard while
          treating everyone with respect.
        </p>
      </div>
      <div class="card panel" id="values">
        <p class="eyebrow">Core values</p>
        <h2>What we stand for</h2>
        <dl class="values">
          {
            coreValues.map((v) => (
              <div>
                <dt>{v.name}</dt>
                <dd>{v.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="departments">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Departments</p>
        <h2>How the team works</h2>
        <p class="lead">Every student joins a department, and everyone pitches in at competition.</p>
      </div>
      <ul class="departments" role="list">
        {
          subteams.map((t) => (
            <li class="dept">
              <span class="icon-badge">
                <Icon name={t.icon} size={20} />
              </span>
              <div>
                <h3>{t.name}</h3>
                <p>{t.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="mentors">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Coaches, mentors & consultants</p>
        <h2>The grown-ups in the room</h2>
      </div>
      {
        groups.map((g) => {
          const list = people.filter((p) => p.data.group === g.key);
          return (
            list.length > 0 && (
              <div class="people-group">
                <h3 class="group-title">{g.title}</h3>
                <ul class="people" role="list">
                  {list.map((p) => (
                    <li class="card person">
                      <span class="avatar" aria-hidden="true">
                        {initials(p.data.name)}
                      </span>
                      <div>
                        <p class="name">{p.data.name}</p>
                        {p.data.focus && <p class="focus">{p.data.focus}</p>}
                        {p.data.job && <p class="job">{p.data.job}</p>}
                        {p.data.note && (
                          <p class="pill pill--gold note">
                            <Icon name="star" size={12} /> {p.data.note}
                          </p>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )
          );
        })
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .split {
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
  :global(.rounded) {
    border-radius: calc(var(--radius) + 4px);
    box-shadow: var(--shadow-md);
    width: 100%;
  }
  .inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .two-col {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  }
  .panel {
    padding: clamp(20px, 3vw, 28px);
  }
  .panel h2 {
    font-size: 1.5rem;
  }
  .panel p:last-child {
    margin-bottom: 0;
  }
  .values {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 20px;
  }
  @media (max-width: 480px) {
    .values {
      grid-template-columns: 1fr;
    }
  }
  .values dt {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--primary);
  }
  .values dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.45;
  }
  .departments,
  .people {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px 24px;
  }
  .departments {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }
  .dept {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .dept h3 {
    margin: 2px 0 2px;
    font-size: 1.05rem;
  }
  .dept p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .icon-badge {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }
  .people {
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  .people-group + .people-group {
    margin-top: 24px;
  }
  .group-title {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 10px;
  }
  .person {
    display: flex;
    gap: 12px;
    padding: 14px;
    align-items: flex-start;
  }
  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: #fff;
    background: linear-gradient(140deg, var(--blue-500), var(--navy-800));
  }
  .person p {
    margin: 0;
    line-height: 1.4;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .focus {
    color: var(--primary);
    font-size: 0.88rem;
  }
  .job {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .note {
    margin-top: 6px !important;
    font-size: 0.75rem;
  }
</style>
