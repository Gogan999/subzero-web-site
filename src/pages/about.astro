---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { coreValues, subteams } from '../data/subteams';
import { getTeamStats } from '../lib/content';
import { withBase } from '../lib/url';

import teamPhoto from '../assets/news/iowa-regional-champions.jpg';
import firstPhoto from '../assets/gallery/2026-season-highlights/07.jpg';

const stats = await getTeamStats();
const people = await getCollection('people');
const groups = [
  { key: 'coach', title: 'Coaches' },
  { key: 'mentor', title: 'Mentors' },
  { key: 'consultant', title: 'Consultants' },
] as const;
---

<BaseLayout
  title="About"
  description="Meet SubZero Robotics, Esko High School's FIRST Robotics Competition team: what FIRST is, our core values, our departments, and the coaches and mentors who guide us."
>
  <!-- Split header -->
  <section class="intro">
    <div class="container intro-grid">
      <div>
        <h1>About SubZero</h1>
        <p class="lead">
          {`SubZero Robotics was founded in ${site.founded} at Esko High School and competed in its first FIRST Robotics Competition season in ${site.rookieYear}.`}
        </p>
        <p class="story">
          In our rookie year we built T.O.M. from the Kit of Parts and won the Rookie Inspiration Award at the Lake
          Superior Regional. A year later, Sir B.A.R.D. earned an Industrial Design Award and took us to the FIRST
          Championship in St. Louis.
        </p>
        <p class="story">
          {`Since then we've won the 2017 Iowa Regional and the 2019 Lake Superior Regional, gone to ${stats.championships} FIRST Championships, and won ${stats.awards} awards for engineering, controls, creativity, spirit and gracious professionalism.`}
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={withBase('/history/')}>Season history</a>
          <a class="textlink" href={withBase('/robots/')}>Our robots</a>
        </div>
      </div>
      <figure>
        <Image src={teamPhoto} alt="SubZero Robotics with the 2017 Iowa Regional winner banner" class="intro-photo" widths={[480, 640, 960]} sizes="(min-width: 900px) 520px, 100vw" loading="eager" />
        <figcaption>Winning the Iowa Regional, 2017.</figcaption>
      </figure>
    </div>
  </section>

  <!-- FIRST -->
  <section class="section section--alt" id="first">
    <div class="container first">
      <Image src={firstPhoto} alt="A SubZero student running the team's CNC router" class="first-photo" widths={[480, 720, 960]} sizes="(min-width: 900px) 540px, 100vw" />
      <div>
        <h2>What is FIRST?</h2>
        <p>
          <a href="https://www.firstinspires.org/" rel="noopener">FIRST</a> (For Inspiration and Recognition of Science
          and Technology) is a global nonprofit that inspires young people to become leaders and innovators in STEM.
        </p>
        <p>
          In the <strong>FIRST Robotics Competition</strong>, high school teams get a new game every January and just a
          few weeks to design, build, wire and program an industrial-sized robot to play it. Teams also raise their own
          funds, run outreach and practice <em>Gracious Professionalism®</em>: competing hard while treating everyone
          with respect.
        </p>
      </div>
    </div>
  </section>

  <!-- Departments -->
  <section class="section" id="departments">
    <div class="container">
      <div class="section-head">
        <h2>Departments</h2>
        <p class="lead">Every student joins a department, and everyone helps out at competitions.</p>
      </div>
      <dl class="departments">
        {
          subteams.map((t) => (
            <div>
              <dt>{t.name}</dt>
              <dd>{t.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Coaches and mentors -->
  <section class="section section--alt" id="mentors">
    <div class="container people-wrap">
      <div>
        <h2>Coaches and mentors</h2>
        <p class="muted">The adults who volunteer with the team, and what they help with.</p>
      </div>
      <div>
        {
          groups.map((g) => {
            const list = people.filter((p) => p.data.group === g.key);
            return (
              list.length > 0 && (
                <div class="people-group">
                  <h3 class="group-title">{g.title}</h3>
                  <ul class="people" role="list">
                    {list.map((p) => (
                      <li>
                        <span class="name">{p.data.name}</span>
                        <span class="focus">
                          {p.data.focus}
                          {p.data.note && <span class="award">{p.data.note}</span>}
                        </span>
                        <span class="job">{p.data.job}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Core values -->
  <section class="section" id="values">
    <div class="container">
      <div class="section-head">
        <h2>Core values</h2>
        <p class="lead">The team wrote these together at a 2019 core values session.</p>
      </div>
      <div class="values">
        {
          coreValues.map((v) => (
            <p>
              <strong>{v.name}.</strong> {v.text}
            </p>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Split header */
  .intro {
    padding-block: clamp(48px, 7vw, 80px) clamp(40px, 6vw, 64px);
    border-bottom: 1px solid var(--border);
  }
  .intro-grid {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }
  .intro h1 {
    margin-bottom: 0.3em;
  }
  .story {
    color: var(--text-soft);
    max-width: 60ch;
  }
  .intro .btn-row {
    margin-top: 24px;
  }
  .intro figure {
    margin: 0;
  }
  figcaption {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 8px;
  }
  .intro :global(.intro-photo),
  .first :global(.first-photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
  }

  /* FIRST */
  .first {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  }
  .first p {
    color: var(--text-soft);
  }
  .first p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 900px) {
    .first {
      grid-template-columns: 1fr;
    }
  }

  /* Departments: a plain two-column list */
  .departments {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(24px, 5vw, 72px);
  }
  .departments > div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 16px;
    padding-block: 14px;
    border-top: 1px solid var(--border);
  }
  .departments dt {
    font-weight: 600;
  }
  .departments dd {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.98rem;
  }
  @media (max-width: 860px) {
    .departments {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .departments > div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  /* Coaches and mentors: a simple table-like list */
  .people-wrap {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 24px clamp(24px, 5vw, 72px);
  }
  .people-group + .people-group {
    margin-top: 28px;
  }
  .group-title {
    font-family: var(--font-body);
    font-stretch: normal;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .people {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .people li {
    display: grid;
    grid-template-columns: 11rem 1fr 1fr;
    gap: 4px 16px;
    padding-block: 10px;
    border-top: 1px solid var(--border);
    font-size: 0.98rem;
  }
  .name {
    font-weight: 600;
  }
  .focus {
    color: var(--text-soft);
  }
  .focus .award {
    display: block;
    font-size: 0.9rem;
  }
  .job {
    color: var(--text-muted);
  }
  @media (max-width: 860px) {
    .people-wrap {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .people li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  /* Core values */
  .values {
    columns: 2 320px;
    column-gap: clamp(24px, 5vw, 72px);
  }
  .values p {
    break-inside: avoid;
    margin-bottom: 14px;
    color: var(--text-soft);
  }
  .values strong {
    color: var(--text);
    font-weight: 600;
  }
</style>
