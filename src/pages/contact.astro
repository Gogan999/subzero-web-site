---
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';

import headerPhoto from '../assets/brand/team-photo.jpg';
---

<BaseLayout
  title="Contact"
  description="Contact SubZero Robotics, FRC Team 5690 in Esko, Minnesota: email the team or coaches, follow us on social media, or learn how to join."
>
  <PageHeader
    image={headerPhoto}
    title="Contact"
    lead="Questions, sponsorship or an invitation to your event: here's how to reach the team."
  />

  <section class="section">
    <div class="container contact-grid">
      <a class="contact-card" href={`mailto:${site.email}`}>
        <h2>Email the team</h2>
        <p class="muted">General questions, sponsorships and event requests.</p>
        <p class="value">{site.email}</p>
      </a>
      {
        site.coaches.map((c) => (
          <a class="contact-card" href={`mailto:${c.email}`}>
            <h2>Coach {c.name}</h2>
            <p class="muted">Reach a head coach directly.</p>
            <p class="value">{c.email}</p>
          </a>
        ))
      }
      <a class="contact-card" href={site.social.facebook} rel="noopener" target="_blank">
        <h2>Facebook</h2>
        <p class="muted">Event updates, photos and match results.</p>
        <p class="value">Esko SubZero Robotics Team 5690</p>
      </a>
      <a class="contact-card" href={site.social.instagram} rel="noopener" target="_blank">
        <h2>Instagram</h2>
        <p class="muted">Behind the scenes in the shop and at competitions.</p>
        <p class="value">@subzerorobotics</p>
      </a>
      <div class="contact-card">
        <h2>Mailing address</h2>
        <address>
          {site.address.lines.map((line) => <span>{line}</span>)}
        </address>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="join">
    <div class="container join">
      <div>
        <h2>Join the team</h2>
        <p class="lead">
          SubZero is open to Esko High School students in grades 9–12. Curiosity and a willingness to learn matter more
          than experience.
        </p>
        <p>
          Builders, coders, artists, writers, planners, photographers and future business leaders all have a place on
          the team. Talk to {site.coaches.map((c) => `Coach ${c.name.split(' ').at(-1)}`).join(' or ')} at school, or
          email the team to find out when the next meeting is.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={`mailto:${site.email}?subject=${encodeURIComponent('I want to join SubZero!')}`}>
            Email us about joining
          </a>
          <a class="textlink" href={withBase('/about/#departments')}>See the departments</a>
        </div>
      </div>
      <div class="card mentor-card">
        <h3>Want to mentor?</h3>
        <p class="muted">
          Engineers, machinists, programmers, designers, business pros and parents: mentors are the backbone of FRC. If
          you have skills to share, we'd love to have you.
        </p>
        <a class="link-arrow" href={`mailto:${site.email}?subject=${encodeURIComponent('Mentoring SubZero')}`}>
          Get in touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: 32px 28px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .contact-card {
    display: block;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
  }
  a.contact-card:hover .value {
    text-decoration: underline;
  }
  .contact-card h2 {
    font-size: 1.3rem;
    margin: 0 0 4px;
  }
  .contact-card p {
    margin: 0;
  }
  .value {
    margin-top: 10px !important;
    font-weight: 600;
    color: var(--link);
    overflow-wrap: anywhere;
  }
  address {
    font-style: normal;
    display: grid;
    margin-top: 8px;
    color: var(--text-muted);
  }
  .join {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
  }
  .mentor-card {
    padding: clamp(24px, 4vw, 36px);
  }
</style>
