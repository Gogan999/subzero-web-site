---
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getSeasons, getTeamStats } from '../lib/content';
import { getAlbums } from '../lib/gallery';
import { withBase } from '../lib/url';

const seasons = await getSeasons();
const stats = await getTeamStats();
const albumIds = new Set((await getAlbums()).map((a) => a.id));
---

<BaseLayout
  title="Season History"
  description={`Every SubZero Robotics season since ${site.rookieYear}: games, robots, events, results and awards for FRC Team ${site.teamNumber}.`}
>
  <PageHeader
    eyebrow="Season history"
    title={`${stats.seasons} seasons of SubZero`}
    lead={`From RECYCLE RUSH in ${site.rookieYear} to today: every game, robot, event and award. Official results come from FIRST.`}
  >
    <ul class="summary" role="list">
      <li><strong>{stats.awards}</strong> awards</li>
      <li><strong>{stats.regionalWins}</strong> regional titles</li>
      <li><strong>{stats.championships}</strong> FIRST Championship trips</li>
    </ul>
  </PageHeader>

  <section class="section">
    <div class="container">
      <ol class="timeline" role="list">
        {
          seasons.map((s, i) => {
            const best = s.data.events.find((e) => /Champion|Finalist|Winner/.test(e.result ?? ''))?.result;
            return (
              <li class:list={['season', { 'season--highlight': s.data.highlight }]} id={`season-${s.id}`}>
                <details class="card season-card" open={i === 0 || s.data.highlight}>
                  <summary>
                    <span class="year">{s.id}</span>
                    <span class="title">
                      <span class="game">{s.data.game}</span>
                      {s.data.robot && <span class="robot">· {s.data.robot}</span>}
                    </span>
                    <span class="badges">
                      {best && <span class="pill pill--gold">{best.split(' · ')[0]}</span>}
                      {s.data.awards.length > 0 && (
                        <span class="pill">
                          <Icon name="trophy" size={12} /> {s.data.awards.length}
                        </span>
                      )}
                    </span>
                    <Icon name="chevron-right" size={18} class="chev" />
                  </summary>
                  <div class="content">
                    {s.data.summary && <p class="lead-sm">{s.data.summary}</p>}
                    {s.data.events.length > 0 && (
                      <ul class="events" role="list">
                        {s.data.events.map((e) => (
                          <li>
                            <div>
                              <p class="event-name">{e.name}</p>
                              {e.location && <p class="muted small">{e.location}</p>}
                            </div>
                            <div class="event-result">
                              {e.rank && <span>Ranked {e.rank}</span>}
                              {e.record && <span class="muted">{e.record}</span>}
                              {e.result && <span class="result">{e.result}</span>}
                            </div>
                          </li>
                        ))}
                      </ul>
                    )}
                    {s.data.awards.length > 0 && (
                      <ul class="awards" role="list">
                        {s.data.awards.map((a) => (
                          <li class="pill pill--gold">
                            <Icon name="trophy" size={14} />
                            <span>
                              {a.name} <span class="muted">· {a.event}</span>
                            </span>
                          </li>
                        ))}
                      </ul>
                    )}
                    {s.data.album && albumIds.has(s.data.album) && (
                      <a class="link-arrow album-link" href={withBase(`/gallery/${s.data.album}/`)}>
                        <Icon name="camera" size={16} /> See photos
                      </a>
                    )}
                  </div>
                </details>
              </li>
            );
          })
        }
      </ol>
      <p class="source muted">
        Results from <a href={site.social.firstEvents} rel="noopener">FIRST Events</a> and
        <a href={site.social.blueAlliance} rel="noopener">The Blue Alliance</a>. Records are qualification wins-losses-ties.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .summary {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    color: rgb(230 245 255 / 0.85);
  }
  .summary strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--gold-400);
    margin-right: 4px;
  }
  .timeline {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 920px;
    display: grid;
    gap: 10px;
  }
  .season--highlight .season-card {
    border-color: color-mix(in srgb, var(--gold-400) 60%, var(--border));
  }
  summary {
    display: grid;
    grid-template-columns: 64px 1fr auto 20px;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .year {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--primary);
  }
  .season--highlight .year {
    color: var(--gold-500);
  }
  .title {
    min-width: 0;
  }
  .game {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
  }
  .robot {
    color: var(--text-muted);
    margin-left: 4px;
  }
  .badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  summary :global(.chev) {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  details[open] summary :global(.chev) {
    transform: rotate(90deg);
  }
  .content {
    padding: 0 18px 18px 94px;
  }
  @media (max-width: 640px) {
    summary {
      grid-template-columns: 48px 1fr 18px;
    }
    .badges {
      display: none;
    }
    .content {
      padding: 0 16px 16px;
    }
  }
  .lead-sm {
    margin: 0 0 12px;
  }
  .events {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: grid;
    gap: 6px;
  }
  .events li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
    padding: 9px 14px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .events p {
    margin: 0;
  }
  .event-name {
    font-weight: 600;
  }
  .small {
    font-size: 0.85rem;
  }
  .event-result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 12px;
    font-size: 0.92rem;
  }
  .result {
    font-weight: 600;
    color: var(--primary);
  }
  .awards {
    list-style: none;
    padding: 0;
    margin: 0 0 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .awards .pill {
    font-size: 0.82rem;
  }
  .awards .muted {
    font-weight: 500;
  }
  .album-link {
    font-size: 0.92rem;
  }
  .source {
    max-width: 920px;
    margin: 20px auto 0;
    font-size: 0.88rem;
    text-align: center;
  }
</style>
