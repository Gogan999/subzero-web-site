---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getRobots, getSeasons, getTeamStats } from '../lib/content';
import { getAlbums } from '../lib/gallery';
import { withBase } from '../lib/url';

import headerPhoto from '../assets/news/iowa-regional-champions.jpg';

const seasons = await getSeasons();
const stats = await getTeamStats();
const albumIds = new Set((await getAlbums()).map((a) => a.id));
const robotImages = new Map((await getRobots()).map((r) => [String(r.year), r.image]));
---

<BaseLayout
  title="Season History"
  description={`Every SubZero Robotics season since ${site.rookieYear}: games, robots, events, results and awards for FRC Team ${site.teamNumber}.`}
>
  <PageHeader
    eyebrow="Season history"
    title={`${stats.seasons} seasons of SubZero`}
    image={headerPhoto}
    lead={`From RECYCLE RUSH in ${site.rookieYear} to today: every game, robot, event and award. Official results come from FIRST.`}
  />

  <section class="stats-wrap" aria-label="Team at a glance">
    <div class="container">
      <dl class="stats">
        <div><dd>{stats.seasons}</dd><dt>Seasons competed</dt></div>
        <div><dd>{stats.awards}</dd><dt>Awards won</dt></div>
        <div><dd>{stats.regionalWins}</dd><dt>Regional titles</dt></div>
        <div><dd>{stats.championships}</dd><dt>FIRST Championship trips</dt></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="seasons" role="list">
        {
          seasons.map((s) => {
            const image = robotImages.get(s.id);
            return (
              <li class:list={['season', { 'season--highlight': s.data.highlight }]} id={`season-${s.id}`}>
                <div class="thumb">
                  {image ? (
                    <Image src={image} alt="" width={480} height={300} fit="cover" widths={[320, 480, 720]} sizes="(min-width: 900px) 560px, 100vw" />
                  ) : (
                    <span class="thumb-year" aria-hidden="true">{s.id}</span>
                  )}
                  <span class="year">{s.id}</span>
                </div>
                <div class="body">
                  <p class="game">{s.data.game}</p>
                  <h2>{s.data.robot ?? `${s.id} season`}</h2>
                  {s.data.summary && <p class="summary">{s.data.summary}</p>}
                  {s.data.events.length > 0 && (
                    <ul class="events" role="list">
                      {s.data.events.map((e) => (
                        <li>
                          <div>
                            <p class="event-name">{e.name}</p>
                            {e.location && <p class="muted small">{e.location}</p>}
                          </div>
                          <div class="event-result">
                            {e.rank && <span>Ranked {e.rank}</span>}
                            {e.record && <span class="muted">{e.record}</span>}
                            {e.result && <span class="result">{e.result}</span>}
                          </div>
                        </li>
                      ))}
                    </ul>
                  )}
                  {s.data.awards.length > 0 && (
                    <ul class="awards" role="list">
                      {s.data.awards.map((a) => (
                        <li class="pill pill--gold" title={a.event}>
                          <Icon name="trophy" size={12} /> {a.name.replace(/ sponsored by .*/, '')}
                        </li>
                      ))}
                    </ul>
                  )}
                  {s.data.album && albumIds.has(s.data.album) && (
                    <a class="link-arrow album-link" href={withBase(`/gallery/${s.data.album}/`)}>
                      <Icon name="camera" size={16} /> See photos
                    </a>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
      <p class="source muted">
        Results from <a href={site.social.firstEvents} rel="noopener">FIRST Events</a> and
        <a href={site.social.blueAlliance} rel="noopener">The Blue Alliance</a>. Records are qualification wins-losses-ties.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Stats */
  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    border-inline: 1px solid var(--border);
  }
  .stats > div {
    padding: 20px 24px;
    border-left: 1px solid var(--border);
  }
  .stats > div:first-child {
    border-left: 0;
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 900;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stats dt {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.82rem;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 6px;
  }
  @media (max-width: 700px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats > div:nth-child(3) {
      border-left: 0;
    }
    .stats > div:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  /* Season cards */
  .seasons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 860px) {
    .seasons {
      grid-template-columns: 1fr;
    }
  }
  .season {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .season--highlight {
    border-color: var(--gold-400);
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 7;
    background: var(--navy-900);
    overflow: hidden;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-year {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 900;
    font-size: 6rem;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(143 211 255 / 0.35);
  }
  .year {
    position: absolute;
    top: 0;
    left: 0;
    padding: 6px 12px;
    background: rgb(5 11 22 / 0.88);
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 900;
    font-size: 1.15rem;
  }
  .season--highlight .year {
    background: var(--gold-400);
    color: var(--on-accent);
  }
  .body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .body > * {
    margin: 0;
  }
  .game {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ice-300);
  }
  h2 {
    font-size: 2rem;
  }
  .summary {
    color: var(--text-soft);
    font-size: 0.95rem;
  }
  .events {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .events li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .events p {
    margin: 0;
  }
  .event-name {
    font-weight: 600;
  }
  .small {
    font-size: 0.85rem;
  }
  .event-result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 12px;
    font-size: 0.9rem;
  }
  .result {
    font-weight: 600;
    color: var(--ice-300);
  }
  .awards {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .awards .pill {
    font-size: 0.75rem;
  }
  .album-link {
    margin-top: auto;
    font-size: 0.92rem;
  }
  .source {
    margin: 24px 0 0;
    font-size: 0.88rem;
    text-align: center;
  }
</style>
