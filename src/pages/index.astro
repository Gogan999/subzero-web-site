---
import { Image } from 'astro:assets';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import NewsCard from '../components/NewsCard.astro';
import RobotCard from '../components/RobotCard.astro';
import SponsorWall from '../components/SponsorWall.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getNews, getRobots, getSeasons, getTeamStats } from '../lib/content';
import { withBase } from '../lib/url';

import teamPhoto from '../assets/brand/team-photo.jpg';

const stats = await getTeamStats();
const [latest] = await getSeasons();
const [robot] = await getRobots();
const news = (await getNews()).slice(0, 3);

const highlights = [
  { year: '2025', text: 'Woodie Flowers Finalist: Laura Zimny' },
  { year: '2019', text: 'Lake Superior Regional Champions' },
  { year: '2017', text: 'Iowa Regional Champions' },
  { year: '2016', text: 'Industrial Design Award & first trip to Worlds' },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero frost">
    <Image
      src={teamPhoto}
      alt=""
      class="hero-bg"
      layout="full-width"
      loading="eager"
      fetchpriority="high"
      widths={[640, 960, 1280, 1600, 2000]}
    />
    <div class="container">
      <p class="eyebrow"><Icon name="snowflake" size={16} /> FIRST Robotics Competition · Team {site.teamNumber}</p>
      <h1>We are <span class="ice">SubZero</span> Robotics.</h1>
      <p class="lead">
        {`High school students from ${site.location} designing, building and programming competition robots since ${site.rookieYear}.`}
      </p>
      <div class="btn-row">
        <a class="btn btn--accent" href={withBase('/robots/')}>See our robots <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn--ghost" href={withBase('/about/')}>Meet the team</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-wrap" aria-label="Team at a glance">
    <div class="container">
      <dl class="stats card">
        <div><dt>Seasons competed</dt><dd>{stats.seasons}</dd></div>
        <div><dt>Awards won</dt><dd>{stats.awards}</dd></div>
        <div><dt>Regional titles</dt><dd>{stats.regionalWins}</dd></div>
        <div><dt>FIRST Championship trips</dt><dd>{stats.championships}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Robot spotlight + latest season + highlights -->
  <section class="section">
    <div class="container spotlight">
      <div class="spot-robot">
        <div class="mini-head">
          <p class="eyebrow">Robot spotlight</p>
          <a class="link-arrow" href={withBase('/robots/')}>All robots <Icon name="arrow-right" size={16} /></a>
        </div>
        <RobotCard robot={robot} featured />
      </div>

      <div class="spot-side">
        <article class="card latest-season">
          <p class="eyebrow">Latest season · {latest.id}</p>
          <h2>{latest.data.game}</h2>
          <ul class="events" role="list">
            {
              latest.data.events.map((e) => (
                <li>
                  <strong>{e.name}</strong>
                  <span class="muted">{[e.rank && `Ranked ${e.rank}`, e.result].filter(Boolean).join(' · ')}</span>
                </li>
              ))
            }
          </ul>
          {
            latest.data.awards.length > 0 && (
              <ul class="awards" role="list">
                {latest.data.awards.map((a) => (
                  <li class="pill pill--gold">
                    <Icon name="trophy" size={14} /> {a.name}
                  </li>
                ))}
              </ul>
            )
          }
          <a class="link-arrow" href={withBase('/history/')}>Every season since {site.rookieYear} <Icon name="arrow-right" size={16} /></a>
        </article>

        <div class="highlights frost">
          <p class="eyebrow">Proudest moments</p>
          <ol role="list">
            {
              highlights.map((h) => (
                <li>
                  <span class="year">{h.year}</span>
                  <span>{h.text}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">News</p>
          <h2>From the pits</h2>
        </div>
        <div class="head-links">
          <a class="link-arrow" href={withBase('/gallery/')}><Icon name="camera" size={16} /> Photo gallery</a>
          <a class="link-arrow" href={withBase('/news/')}>All news <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
      <div class="grid grid--3">
        {news.map((post) => <NewsCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- Sponsors -->
  <section class="section sponsors">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Our partners</p>
          <h2>Powered by our sponsors</h2>
        </div>
        <a class="link-arrow" href={withBase('/sponsors/')}>Become a sponsor <Icon name="arrow-right" size={16} /></a>
      </div>
      <SponsorWall variant="strip" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    min-height: min(62vh, 560px);
    display: flex;
    align-items: flex-end;
    padding-block: 72px 92px;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    z-index: -2;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(5 13 26 / 0.9) 0%, rgb(5 13 26 / 0.62) 45%, rgb(5 13 26 / 0.2) 100%),
      linear-gradient(0deg, rgb(5 13 26 / 0.85) 0%, transparent 55%);
  }
  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    max-width: 13ch;
    margin-bottom: 0.25em;
  }
  .ice {
    background: linear-gradient(100deg, #fff 10%, var(--ice-300) 60%, var(--blue-400));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero .lead {
    max-width: 48ch;
    margin-bottom: 22px;
  }
  @media (max-width: 640px) {
    .hero::after {
      background: linear-gradient(0deg, rgb(5 13 26 / 0.95) 20%, rgb(5 13 26 / 0.5) 100%);
    }
  }

  /* Stats */
  .stats-wrap {
    position: relative;
    margin-top: -44px;
    z-index: 2;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 4px;
    box-shadow: var(--shadow-md);
  }
  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    padding: 12px 16px;
    text-align: center;
  }
  .stats > div + div {
    border-left: 1px solid var(--border);
  }
  .stats dt {
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
    line-height: 1.1;
    color: var(--primary);
  }
  @media (max-width: 720px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stats > div:nth-child(3) {
      border-left: 0;
    }
    .stats > div:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  /* Spotlight row */
  .spotlight {
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
  }
  @media (max-width: 900px) {
    .spotlight {
      grid-template-columns: 1fr;
    }
  }
  .mini-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .spot-side {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    margin-top: 30px;
  }
  @media (max-width: 900px) {
    .spot-side {
      margin-top: 0;
    }
  }
  .latest-season {
    padding: 20px 22px;
  }
  .latest-season h2 {
    font-size: 1.6rem;
  }
  .events {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: grid;
    gap: 8px;
  }
  .events li {
    display: grid;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-size: 0.95rem;
  }
  .events .muted {
    font-size: 0.88rem;
  }
  .awards {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .highlights {
    border-radius: var(--radius);
    padding: 20px 22px;
  }
  .highlights ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .highlights li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 10px;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .highlights li:last-child {
    border-bottom: 0;
  }
  .year {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--gold-400);
  }

  .head-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
</style>
