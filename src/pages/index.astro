---
import { Image } from 'astro:assets';
import JoinBand from '../components/JoinBand.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { formatDate, getNews, getRobots, getSeasons, getTeamStats } from '../lib/content';
import { withBase } from '../lib/url';

import historyPhoto from '../assets/news/iowa-regional-champions.jpg';
import outreachPhoto from '../assets/gallery/2016-lego-camp/03.jpg';
import galleryPhoto from '../assets/gallery/2026-season-highlights/01.jpg';
import sponsorsPhoto from '../assets/gallery/2026-season-highlights/17.jpg';
import aboutPhoto from '../assets/gallery/2026-season-highlights/07.jpg';

const stats = await getTeamStats();
const [robot] = await getRobots();
const [season] = await getSeasons();
const [leadPost, ...otherPosts] = (await getNews()).slice(0, 3);
const robotName = robot.name ?? `${robot.year} Robot`;
const awardsAt = (event: string) => season.data.awards.filter((a) => a.event === event).map((a) => a.name.replace(/ sponsored by .*/, ''));

// History is the big tile; the rest share the right-hand columns.
const tiles = [
  { href: '/outreach/', title: 'Outreach', text: 'LEGO camps, FLL teams and robots at community events.', image: outreachPhoto },
  { href: '/gallery/', title: 'Gallery', text: `Photo albums from ${site.rookieYear} to today.`, image: galleryPhoto },
  { href: '/sponsors/', title: 'Sponsors', text: 'The partners who make each season possible.', image: sponsorsPhoto },
  { href: '/about/', title: 'About the team', text: 'Departments, mentors and what FIRST is.', image: aboutPhoto },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    {
      robot.image && (
        <Image src={robot.image} alt="" class="hero-bg" layout="full-width" loading="eager" fetchpriority="high" widths={[640, 960, 1280, 1600]} />
      )
    }
    <div class="container hero-inner">
      <h1>SubZero Robotics</h1>
      <p class="meta">FIRST Robotics Competition Team {site.teamNumber} · {site.location}</p>
      <p class="lead">
        {`High school students from Esko designing, building and programming competition robots since ${site.rookieYear}.`}
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={withBase('/robots/')}>See our robots</a>
        <a class="textlink" href={withBase('/about/')}>Meet the team</a>
      </div>
    </div>
    <p class="hero-caption">{robotName}, our {robot.year} robot</p>
  </section>

  <!-- Latest season results -->
  {
    season.data.events.length > 0 && (
      <section class="results" aria-label={`${season.id} season results`}>
        <div class="container results-row" style={`--events:${season.data.events.length}`}>
          <p class="yr">
            {season.id}
            <span>{season.data.game}</span>
          </p>
          {season.data.events.map((e) => (
            <p class="ev">
              <strong>{e.name}</strong>
              {[e.rank && `Ranked ${e.rank}`, e.record].filter(Boolean).join(', ')}
              {e.result && `. ${e.result}.`}{' '}
              {awardsAt(e.name).map((a) => (
                <span class="award">{a}</span>
              ))}
            </p>
          ))}
          <a class="textlink" href={withBase('/history/')}>All {stats.seasons} seasons</a>
        </div>
      </section>
    )
  }

  <!-- Robot spotlight -->
  <section class="section">
    <div class="container feature">
      <figure>
        {robot.image && <Image src={robot.image} alt={`${robotName}, SubZero's ${robot.year} robot`} widths={[480, 720, 960]} sizes="(min-width: 820px) 640px, 100vw" />}
        {robot.onshape && <figcaption>{robotName}, {robot.year}. The full CAD model is public in Onshape.</figcaption>}
      </figure>
      <div class="feature-body">
        <h2>This year's robot: {robotName}</h2>
        <p class="meta">{robot.year} game: {robot.game}</p>
        {robot.summary && <p>{robot.summary}</p>}
        {
          robot.specs.length > 0 && (
            <ul class="specs" role="list">
              {robot.specs.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          )
        }
        <div class="btn-row">
          <a class="btn btn--primary" href={withBase('/robots/')}>All robots</a>
          {robot.onshape && <a class="textlink" href={robot.onshape} rel="noopener" target="_blank">Open the CAD in Onshape</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- Explore tiles -->
  <section class="section explore">
    <div class="container">
      <h2>Inside SubZero</h2>
      <div class="tiles">
        <a class="tile big" href={withBase('/history/')}>
          <Image src={historyPhoto} alt="" widths={[600, 900]} sizes="(min-width: 860px) 50vw, 100vw" />
          <span class="tile-text">
            <strong>History</strong>
            <span>{`${stats.seasons} seasons, ${stats.regionalWins} regional titles and ${stats.championships} trips to the FIRST Championship. This is the team after winning the 2017 Iowa Regional.`}</span>
          </span>
        </a>
        {
          tiles.map((t) => (
            <a class="tile" href={withBase(t.href)}>
              <Image src={t.image} alt="" widths={[400, 600]} sizes="(min-width: 860px) 25vw, (min-width: 480px) 50vw, 100vw" />
              <span class="tile-text">
                <strong>{t.title}</strong>
                <span>{t.text}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- News: the newest post leads, the next two sit beside it -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--row">
        <h2>News</h2>
        <a class="textlink" href={withBase('/news/')}>All news</a>
      </div>
      <div class="news">
        {
          leadPost && (
            <article class="lead-story">
              {leadPost.data.cover && (
                <Image src={leadPost.data.cover} alt={leadPost.data.coverAlt ?? ''} widths={[480, 720, 960]} sizes="(min-width: 820px) 640px, 100vw" />
              )}
              <p class="meta">
                <time datetime={leadPost.data.date.toISOString()}>{formatDate(leadPost.data.date)}</time>
              </p>
              <h3>
                <a href={withBase(`/news/${leadPost.id}/`)}>{leadPost.data.title}</a>
              </h3>
              <p>{leadPost.data.summary}</p>
            </article>
          )
        }
        <div class="side">
          {
            otherPosts.map((post) => (
              <article class:list={{ noimg: !post.data.cover }}>
                <div>
                  <p class="meta">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  </p>
                  <h3>
                    <a href={withBase(`/news/${post.id}/`)}>{post.data.title}</a>
                  </h3>
                  <p>{post.data.summary}</p>
                </div>
                {post.data.cover && <Image src={post.data.cover} alt="" width={240} height={240} fit="cover" />}
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <JoinBand />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
    z-index: -2;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(8 17 31 / 0.94) 0%, rgb(8 17 31 / 0.8) 40%, rgb(8 17 31 / 0.1) 80%);
  }
  .hero-inner {
    padding-block: clamp(64px, 10vw, 120px) clamp(48px, 7vw, 84px);
  }
  .hero h1 {
    font-size: clamp(3rem, 8.5vw, 6rem);
    max-width: 9ch;
    margin-bottom: 0.25em;
  }
  .hero .meta {
    color: var(--text-soft);
    font-size: 1.1rem;
    margin-bottom: 1.2em;
  }
  .hero .lead {
    max-width: 42ch;
    margin-bottom: 28px;
  }
  .hero-caption {
    position: absolute;
    right: var(--gutter);
    bottom: 12px;
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-soft);
    background: rgb(8 17 31 / 0.7);
    padding: 2px 8px;
  }
  @media (max-width: 640px) {
    .hero::after {
      background: rgb(8 17 31 / 0.78);
    }
    .hero-caption {
      display: none;
    }
  }

  /* Latest season */
  .results {
    border-bottom: 1px solid var(--border);
  }
  .results-row {
    display: grid;
    grid-template-columns: auto repeat(var(--events, 2), 1fr) auto;
    gap: 16px 36px;
    align-items: baseline;
    padding-block: 22px;
  }
  .results p {
    margin: 0;
  }
  .yr {
    font-family: var(--font-display);
    font-stretch: 78%;
    font-weight: 750;
    font-size: 1.6rem;
    line-height: 1;
  }
  .yr span {
    display: block;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-top: 4px;
  }
  .ev {
    font-size: 0.98rem;
    color: var(--text-soft);
    font-variant-numeric: tabular-nums;
  }
  .ev strong {
    display: block;
    font-weight: 600;
    color: var(--text);
  }
  @media (max-width: 860px) {
    .results-row {
      grid-template-columns: 1fr 1fr;
    }
    .yr {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .results-row {
      grid-template-columns: 1fr;
    }
  }

  /* Robot spotlight */
  .feature {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  .feature figure {
    margin: 0;
  }
  .feature figcaption {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 8px;
  }
  .feature-body {
    min-width: 0;
  }
  .feature-body h2 {
    margin-bottom: 0.15em;
  }
  .feature-body .meta {
    margin-bottom: 14px;
  }
  .feature-body p {
    color: var(--text-soft);
  }
  .specs {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    border-top: 1px solid var(--border);
  }
  .specs li {
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.97rem;
  }
  @media (max-width: 820px) {
    .feature {
      grid-template-columns: 1fr;
    }
  }

  /* Explore tiles */
  .explore {
    padding-top: 0;
  }
  .tiles {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 14px;
    margin-top: 20px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }
  .tile :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .tile.big {
    grid-row: span 2;
    display: grid;
    grid-template-rows: minmax(280px, 1fr) auto;
  }
  .tile.big :global(img) {
    height: 100%;
    aspect-ratio: auto;
  }
  .tile strong {
    display: block;
    font-family: var(--font-display);
    font-stretch: 80%;
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.1;
  }
  .tile.big strong {
    font-size: 1.7rem;
  }
  .tile-text span {
    display: block;
    margin-top: 2px;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .tile:hover strong {
    text-decoration: underline;
    text-decoration-color: var(--gold-400);
    text-underline-offset: 4px;
  }
  @media (max-width: 860px) {
    .tiles {
      grid-template-columns: 1fr 1fr;
    }
    .tile.big {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .tile.big {
      grid-template-rows: auto auto;
    }
    .tile.big :global(img) {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 480px) {
    .tiles {
      grid-template-columns: 1fr;
    }
  }

  /* News */
  .news {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(24px, 4vw, 48px);
  }
  .news article {
    min-width: 0;
  }
  .news h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .news h3 a:hover {
    text-decoration: underline;
  }
  .news p:not(.meta) {
    color: var(--text-soft);
    font-size: 0.98rem;
  }
  .news .meta {
    margin-bottom: 6px;
  }
  .lead-story :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-bottom: 14px;
  }
  .lead-story h3 {
    font-size: 1.75rem;
  }
  .side article {
    display: grid;
    grid-template-columns: 1fr 120px;
    gap: 16px;
    padding-block: 18px;
    border-top: 1px solid var(--border);
  }
  .side article:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .side article.noimg {
    grid-template-columns: 1fr;
  }
  .side :global(img) {
    width: 120px;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .side p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 820px) {
    .news {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .side article {
      grid-template-columns: 1fr 84px;
    }
    .side :global(img) {
      width: 84px;
    }
  }
</style>
