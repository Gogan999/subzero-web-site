---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import JoinBand from '../components/JoinBand.astro';
import NewsCard from '../components/NewsCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getNews, getRobots, getTeamStats } from '../lib/content';
import { withBase } from '../lib/url';

import historyPhoto from '../assets/news/iowa-regional-champions.jpg';
import outreachPhoto from '../assets/gallery/2016-lego-camp/03.jpg';
import galleryPhoto from '../assets/gallery/2026-season-highlights/01.jpg';
import sponsorsPhoto from '../assets/gallery/2026-season-highlights/17.jpg';

const stats = await getTeamStats();
const [robot] = await getRobots();
const news = (await getNews()).slice(0, 3);
const robotName = robot.name ?? `${robot.year} Robot`;

const tiles = [
  { href: '/history/', title: 'History', text: `${stats.seasons} seasons, ${stats.regionalWins} regional titles and ${stats.championships} trips to the FIRST Championship.`, image: historyPhoto },
  { href: '/outreach/', title: 'Outreach', text: 'LEGO camps, FLL teams and robots at every community event.', image: outreachPhoto },
  { href: '/gallery/', title: 'Gallery', text: `Photo albums from our ${site.rookieYear} rookie year to today.`, image: galleryPhoto },
  { href: '/sponsors/', title: 'Sponsors', text: 'The local partners who make every season possible.', image: sponsorsPhoto },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    {
      robot.image && (
        <Image src={robot.image} alt="" class="hero-bg" layout="full-width" loading="eager" fetchpriority="high" widths={[640, 960, 1280, 1600]} />
      )
    }
    <div class="container hero-inner">
      <span class="ghost ghost-num" aria-hidden="true">{site.teamNumber}</span>
      <p class="eyebrow">FIRST Robotics Competition · {site.location}</p>
      <h1>We are <em>SubZero</em> Robotics.</h1>
      <p class="lead">
        {`High school students from ${site.location} designing, building and programming competition robots since ${site.rookieYear}.`}
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={withBase('/robots/')}>See our robots</a>
        <a class="btn btn--ghost" href={withBase('/about/')}>Meet the team</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-wrap" aria-label="Team at a glance">
    <div class="container">
      <dl class="stats">
        <div><dd>{stats.seasons}</dd><dt>Seasons competed</dt></div>
        <div><dd>{stats.awards}</dd><dt>Awards won</dt></div>
        <div><dd>{stats.regionalWins}</dd><dt>Regional titles</dt></div>
        <div><dd>{stats.championships}</dd><dt>FIRST Championship trips</dt></div>
      </dl>
    </div>
  </section>

  <!-- Robot spotlight -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Robot spotlight · {robot.year}</p>
      <h2>Meet {robotName}</h2>
      <div class="feature">
        <div class="feature-media">
          {robot.image && <Image src={robot.image} alt={`${robotName}, SubZero's ${robot.year} robot`} widths={[480, 720, 960]} sizes="(min-width: 820px) 640px, 100vw" />}
          <span class="tag">Current robot</span>
        </div>
        <div class="feature-body">
          <h3>{robotName}</h3>
          <p class="game">{robot.game} · {robot.year}</p>
          {robot.summary && <p>{robot.summary}</p>}
          {
            robot.specs.length > 0 && (
              <ul class="specs" role="list">
                {robot.specs.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            )
          }
          <div class="btn-row">
            <a class="btn btn--primary" href={withBase('/robots/')}>All robots</a>
            {robot.onshape && <a class="btn btn--ghost" href={robot.onshape} rel="noopener" target="_blank">CAD in Onshape</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Explore tiles -->
  <section class="section explore">
    <div class="container">
      <p class="eyebrow">Explore</p>
      <h2>Inside SubZero</h2>
      <div class="tiles">
        {
          tiles.map((t) => (
            <a class="tile" href={withBase(t.href)}>
              <Image src={t.image} alt="" widths={[400, 600]} sizes="(min-width: 860px) 25vw, (min-width: 480px) 50vw, 100vw" />
              <div>
                <strong>{t.title}</strong>
                <span>{t.text}</span>
                <i>Open {t.title} <Icon name="arrow-right" size={14} /></i>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">News</p>
          <h2>From the pits</h2>
        </div>
        <a class="btn btn--ghost" href={withBase('/news/')}>All news</a>
      </div>
      <div class="grid grid--3">
        {news.map((post) => <NewsCard post={post} />)}
      </div>
    </div>
  </section>

  <JoinBand />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
    z-index: -2;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(5 11 22 / 0.96) 0%, rgb(5 11 22 / 0.75) 42%, rgb(5 11 22 / 0.15) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 40%);
  }
  .hero-inner {
    position: relative;
    padding-block: clamp(70px, 12vw, 140px) 110px;
  }
  .ghost {
    position: absolute;
    right: var(--gutter);
    bottom: -0.18em;
    font-size: clamp(7rem, 22vw, 17rem);
    line-height: 1;
    -webkit-text-stroke-color: rgb(143 211 255 / 0.35);
    pointer-events: none;
    z-index: -1;
  }
  .hero h1 {
    font-size: clamp(3.2rem, 9vw, 6.6rem);
    max-width: 10ch;
    margin-bottom: 0.2em;
  }
  .hero em {
    font-style: normal;
    color: var(--ice-300);
  }
  .hero .lead {
    max-width: 44ch;
    margin-bottom: 28px;
  }
  @media (max-width: 640px) {
    .hero::after {
      background: linear-gradient(0deg, rgb(5 11 22 / 0.95) 20%, rgb(5 11 22 / 0.55) 100%);
    }
  }

  /* Stats */
  .stats {
    margin: -56px 0 0;
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .stats > div {
    padding: 22px 24px;
    border-left: 1px solid var(--border);
  }
  .stats > div:first-child {
    border-left: 0;
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 900;
    font-size: clamp(2.6rem, 6vw, 3.8rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stats dt {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.82rem;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 6px;
  }
  @media (max-width: 700px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats > div:nth-child(3) {
      border-left: 0;
    }
    .stats > div:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  /* Robot spotlight */
  .feature {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    border: 1px solid var(--border);
    background: var(--surface);
    margin-top: 28px;
  }
  .feature-media {
    position: relative;
    min-height: 320px;
  }
  .feature-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tag {
    position: absolute;
    left: 0;
    top: 0;
    background: var(--gold-400);
    color: var(--on-accent);
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 10px 14px;
  }
  .feature-body {
    padding: 32px;
    min-width: 0;
  }
  .feature-body h3 {
    font-size: 3.4rem;
    margin-bottom: 0.1em;
  }
  .game {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ice-300);
    margin-bottom: 14px;
  }
  .feature-body p {
    color: var(--text-soft);
  }
  .specs {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    border-top: 1px solid var(--border);
  }
  .specs li {
    display: flex;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .specs li::before {
    content: '';
    width: 8px;
    height: 8px;
    margin-top: 8px;
    flex: none;
    background: var(--ice-300);
    transform: rotate(45deg);
  }
  @media (max-width: 820px) {
    .feature {
      grid-template-columns: 1fr;
    }
    .feature-media {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
    .feature-body {
      padding: 24px 20px;
    }
  }

  /* Explore tiles */
  .explore {
    padding-top: 0;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    margin-top: 28px;
  }
  .tile {
    position: relative;
    isolation: isolate;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    color: #fff;
    text-decoration: none;
  }
  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.5s ease;
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(5 11 22 / 0.95), rgb(5 11 22 / 0.1) 65%);
  }
  .tile:hover :global(img) {
    transform: scale(1.05);
  }
  .tile div {
    padding: 18px;
  }
  .tile strong {
    display: block;
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 900;
    font-size: 2rem;
    line-height: 1;
    text-transform: uppercase;
  }
  .tile span {
    display: block;
    margin-top: 6px;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--text-soft);
  }
  .tile i {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-style: normal;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ice-300);
  }
  @media (max-width: 860px) {
    .tiles {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .tiles {
      grid-template-columns: 1fr;
    }
    .tile {
      aspect-ratio: 16 / 10;
    }
  }
</style>
