---
import Icon from '../../components/Icon.astro';
import NewsCard from '../../components/NewsCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNews } from '../../lib/content';
import { withBase } from '../../lib/url';

const posts = await getNews();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

<BaseLayout title="News" description="News, competition recaps and team updates from SubZero Robotics, FRC Team 5690.">
  <PageHeader eyebrow="News" title="From the pits" lead="Competition recaps, awards, outreach and team updates.">
    <p class="rss">
      <a href={withBase('/rss.xml')}><Icon name="rss" size={16} /> Subscribe via RSS</a>
    </p>
  </PageHeader>

  <section class="section">
    <div class="container">
      {
        years.map((year) => (
          <section class="year-group" aria-labelledby={`y-${year}`}>
            <h2 id={`y-${year}`} class="year">{year}</h2>
            <div class="grid grid--3">
              {posts
                .filter((p) => p.data.date.getUTCFullYear() === year)
                .map((post) => (
                  <NewsCard post={post} />
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .rss {
    margin: 20px 0 0;
  }
  .rss a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .year-group + .year-group {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .year {
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .year::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
</style>
