---
import { Image } from 'astro:assets';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';

import legoCamp from '../assets/gallery/2016-lego-camp/03.jpg';
import fll from '../assets/gallery/2016-rookie-fll-teams/08.jpg';
import funDays from '../assets/gallery/2016-esko-fun-days/02.jpg';
import huskies from '../assets/gallery/2016-huskies-night/05.jpg';
import kickoff from '../assets/news/kickoff-2018/topperbots-workshop.jpg';
import jumpstart from '../assets/gallery/2016-jumpstart/06.jpg';
import service from '../assets/gallery/2020-2021-season/13.jpg';
import minneMini from '../assets/gallery/2019-minne-mini/01.jpg';

const programs = [
  {
    title: 'LEGO Robotics Summer Camp',
    text: 'Our "Thawed Out" summer camp introduces younger students to building and programming LEGO robots, with obstacle-course challenges and friendly competition.',
    image: legoCamp,
    alt: 'Two young campers showing off the LEGO robot they built',
    album: '2016-lego-camp',
  },
  {
    title: 'FIRST LEGO League teams',
    text: "SubZero helped sponsor and mentor Esko's rookie FIRST LEGO League teams, Esko Frozen Robotics and 7-7 & Older, building a pipeline of future SubZero members.",
    image: fll,
    alt: 'Esko FIRST LEGO League team members in matching shirts at a tournament',
    album: '2016-rookie-fll-teams',
  },
  {
    title: 'Hosting kickoff with Northland teams',
    text: 'Together with the Marshall School TopperBots (4230), we have co-hosted kickoff strategy workshops where Northland FRC teams break down the new game together.',
    image: kickoff,
    alt: 'FRC teams in a breakout session at the kickoff workshop',
    album: '2017-steamworks-kickoff',
  },
  {
    title: 'Community events',
    text: "From the Esko Fun Days parade, with a candy-and-T-shirt cannon robot, to Robotics Night at a Duluth Huskies game, we bring robots wherever our community gathers. We've also volunteered to help set up Bentleyville's Tour of Lights.",
    image: funDays,
    alt: 'SubZero team members with their parade float at Esko Fun Days',
    album: '2016-esko-fun-days',
  },
  {
    title: 'Driving lessons for future engineers',
    text: 'Nothing sparks interest like taking the controls. At community events, kids get to drive our competition robots with a SubZero driver by their side.',
    image: huskies,
    alt: 'A SubZero student showing a young community member how to drive the robot',
    album: '2016-huskies-night',
  },
  {
    title: 'Sharing what we learn',
    text: "We've presented at St. Cloud State's JUMPSTART workshop, written for the BlueDevil Press with the Duluth East Daredevils, and talked robots live on WKLK radio.",
    image: jumpstart,
    alt: 'SubZero alumni presenting at the JUMPSTART workshop',
    album: '2016-jumpstart',
  },
  {
    title: 'Serving our community',
    text: 'When the pandemic kept us out of the shop, we turned our energy to service: assembling STEM kits for local elementary students and making fleece tie blankets.',
    image: service,
    alt: 'SubZero members with a group of elementary students holding STEM kits',
    album: '2020-2021-season',
  },
  {
    title: 'Off-season events',
    text: 'Events like the Minne Mini keep our skills sharp between seasons and give new members their first taste of competition.',
    image: minneMini,
    alt: 'SubZero at the Minne Mini off-season event',
    album: '2019-minne-mini',
  },
];
---

<BaseLayout
  title="Outreach"
  description="How SubZero Robotics shares STEM with Esko and the Northland: LEGO camps, FIRST LEGO League teams, kickoff workshops, parades and community service."
>
  <PageHeader
    eyebrow="Community outreach"
    title="Sharing STEM with our community"
    lead="Building robots is only half of what we do. We work to inspire younger students, support fellow teams and give back to the community that supports us."
  />

  <section class="section">
    <div class="container">
      <ul class="programs" role="list">
        {
          programs.map((p) => (
            <li class="program">
              <div class="media">
                <Image src={p.image} alt={p.alt} width={720} height={480} fit="cover" widths={[480, 720, 1080]} sizes="(min-width: 960px) 540px, 100vw" />
              </div>
              <div class="body">
                <h2>{p.title}</h2>
                <p>{p.text}</p>
                <a class="link-arrow" href={withBase(`/gallery/${p.album}/`)}>
                  <Icon name="camera" size={16} /> View photos
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow center">
      <p class="eyebrow">Invite us</p>
      <h2>Want SubZero at your event?</h2>
      <p class="lead">
        Schools, libraries, festivals and community groups: we'd love to bring a robot and talk STEM with your audience.
      </p>
      <a class="btn btn--primary" href={withBase('/contact/')}>Get in touch</a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .programs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
  }
  .program {
    display: grid;
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
  }
  .program:nth-child(even) .media {
    order: 2;
  }
  @media (max-width: 820px) {
    .program:nth-child(even) .media {
      order: 0;
    }
  }
  .media :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: calc(var(--radius) + 4px);
    box-shadow: var(--shadow-md);
  }
  .body h2 {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
  }
  .body p {
    color: var(--text-muted);
    font-size: 1.08rem;
  }
  .center {
    text-align: center;
  }
  .center .lead {
    margin-inline: auto;
  }
</style>
