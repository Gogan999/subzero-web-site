---
import PageHeader from '../components/PageHeader.astro';
import RobotCard from '../components/RobotCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getRobots } from '../lib/content';

import headerPhoto from '../assets/robots/2019.jpg';

const robots = await getRobots();
---

<BaseLayout
  title="Robots"
  description={`Every robot built by SubZero Robotics, FRC Team ${site.teamNumber}, since ${site.rookieYear}: names, games, specs, awards and technical binders.`}
>
  <PageHeader
    eyebrow="Our robots"
    title="Built in Esko."
    image={headerPhoto}
    lead={`${robots.length} robots and counting. Each one designed, machined, wired and programmed by students in a few short weeks.`}
  />

  <section class="section">
    <div class="container">
      <div class="robot-grid">
        {robots.map((robot, i) => <RobotCard robot={robot} featured={i === 0} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .robot-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 1000px) {
    .robot-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .robot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
