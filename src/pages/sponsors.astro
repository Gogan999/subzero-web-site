---
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import SponsorWall from '../components/SponsorWall.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getSponsors } from '../lib/sponsors';

import headerPhoto from '../assets/gallery/2026-season-highlights/17.jpg';

const past = (await getSponsors('past')).sort((a, b) => a.name.localeCompare(b.name));

const impact = [
  { title: 'Robot and field parts', text: 'Motors, aluminum, electronics and practice field elements.' },
  { title: 'Competitions', text: 'Event registration, travel and lodging for regionals.' },
  { title: 'Student growth', text: 'Hands-on engineering, business and leadership experience.' },
  { title: 'Outreach', text: 'Camps and demos that bring STEM to younger students.' },
] as const;

const mailto = `mailto:${site.email}?subject=${encodeURIComponent('SubZero sponsorship (Attn: Business Department)')}`;
---

<BaseLayout
  title="Sponsors"
  description="Partner with SubZero Robotics, FRC Team 5690. Meet our sponsors, see sponsorship levels and learn how your support helps Esko students."
>
  <PageHeader
    image={headerPhoto}
    title="Sponsors"
    lead="SubZero is funded by local businesses, foundations, community groups and families. Their support pays for parts, travel and outreach."
  >
    <div class="btn-row hero-ctas">
      <a class="btn btn--primary" href={mailto}>Become a sponsor</a>
      <a class="textlink" href="#donate">Make a donation</a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">2025–26 partners</p>
        <h2>Thank you to our sponsors</h2>
      </div>
      <SponsorWall />
    </div>
  </section>

  <section class="section section--alt" id="levels">
    <div class="container sponsor-info">
      <div>
        <h2>What sponsorship pays for</h2>
        <ul class="impact" role="list">
          {
            impact.map((i) => (
              <li>
                <div>
                  <h3>{i.title}</h3>
                  <p>{i.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card levels">
        <h3>Partner with us</h3>
        <p>
          Every partner is recognized on this site and invited to join us at the Lake Superior Regional. Reach out to our
          Business Department to talk about sponsorship.
        </p>
        <a class="btn btn--primary" href={mailto}>Contact our Business Department</a>
      </div>
    </div>
  </section>

  <section class="section" id="donate">
    <div class="container donate">
      <div class="card donate-card">
        <div>
          <h2>Make a donation</h2>
          <p>
            Individual gifts of any size help. Mail your donation, marked for <strong>SubZero Robotics</strong>, to:
          </p>
          <address>
            {site.address.lines.map((line) => <span>{line}</span>)}
          </address>
          <p class="muted small">
            Questions about giving? Email <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </div>
      </div>
      <details class="card past">
        <summary>
          <span>
            <strong>Past supporters</strong>
            <span class="muted"> · {past.length} businesses and organizations</span>
          </span>
          <Icon name="chevron-right" size={18} class="chev" />
        </summary>
        <ul role="list">
          {past.map((s) => <li>{s.name}</li>)}
        </ul>
      </details>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-ctas {
    margin-top: 20px;
  }
  .sponsor-info {
    display: grid;
    gap: clamp(24px, 4vw, 48px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    align-items: start;
  }
  .impact {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .impact li {
    border-top: 1px solid var(--border);
    padding-top: 10px;
  }
  .impact h3 {
    font-family: var(--font-body);
    font-stretch: normal;
    font-weight: 600;
    font-size: 1rem;
    margin: 0 0 2px;
  }
  .impact p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .levels {
    padding: clamp(20px, 3vw, 28px);
  }
  .small {
    font-size: 0.9rem;
  }
  .donate {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    align-items: start;
  }
  .donate-card {
    display: flex;
    gap: 16px;
    padding: clamp(20px, 3vw, 28px);
  }
  .donate-card h2 {
    font-size: 1.4rem;
  }
  address {
    font-style: normal;
    display: grid;
    padding: 12px 16px;
    margin-bottom: 12px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-weight: 500;
  }
  .past summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
  }
  .past summary::-webkit-details-marker {
    display: none;
  }
  .past :global(.chev) {
    transition: transform 0.2s ease;
  }
  .past[open] :global(.chev) {
    transform: rotate(90deg);
  }
  .past ul {
    list-style: none;
    margin: 0;
    padding: 0 20px 18px;
    columns: 2 200px;
    column-gap: 20px;
  }
  .past li {
    break-inside: avoid;
    padding: 4px 0;
    font-size: 0.92rem;
    border-bottom: 1px solid var(--border);
  }
</style>
